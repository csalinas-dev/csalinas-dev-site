// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model User {
  id                String       @id @default(cuid())
  name              String?
  email             String?      @unique
  emailVerified     DateTime?
  password          String? // Added for credentials authentication
  image             String?
  accounts          Account[]
  sessions          Session[]
  wordleGames       WordleGame[]
  streak            Int          @default(0)
  maxStreak         Int          @default(0)
  lastPlayedDate    String? // Format: yyyy-mm-dd
  // Wordleverse leaderboard is opt-in: OAuth hands us real names the user never
  // meant to publish, so nobody is listed until they say so.
  showOnLeaderboard Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Realtime Multiplayer Models
//
// One row per live game room, shared by every realtime game on the site. The
// row is the single source of truth: `state` and `players` are opaque JSON that
// only the per-game reducer understands, and `revision` is the optimistic
// concurrency token every mutation must present. Rooms are disposable — they
// are swept an hour after their last accepted action (see ROOM_TTL_MS).
model GameRoom {
  code      String   @id @db.VarChar(4) // "K7F2" — unambiguous alphabet, see src/lib/realtime/codes.js
  game      String // registry key: "tto" | "edge-case" | ...
  state     Json // game-specific, opaque to src/lib/realtime
  players   Json // Player[] — { token, slot, name, color, connectedAt, lastSeenAt }
  revision  Int      @default(0) // bumped on every accepted mutation
  status    String   @default("lobby") // lobby | playing | over
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Expiry sweeps and the SSE watcher both order by last activity.
  @@index([updatedAt])
}

// Wordleverse Models
model WordleGame {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // Format: yyyy-mm-dd
  word      String
  board     Json // Serialized board state
  keyboard  Json // Serialized keyboard state
  guesses   Json? // Array of guesses made
  row       Int
  expert    Boolean  @default(false)
  win       Boolean?
  completed Boolean  @default(false)
  playable  Boolean  @default(true) // Whether this game can still be played (for past games)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Blog posts ingested from the Substack RSS feed (src/lib/substack).
//
// Additive by construction: the deploy runs `prisma db push` WITHOUT
// --accept-data-loss (.github/workflows/deploy.yml), so this table may only ever
// gain columns. Nothing in src/lib/substack deletes a row — a feed that stops
// listing a post (RSS shows only the most recent ~20) must never remove it.
model SubstackPost {
  id          String   @id @default(cuid())
  // The RSS <guid>. Substack emits the canonical post URL with
  // isPermaLink="false" and exposes no numeric id, so this is the only stable
  // identity available. NOT the title -- see #151 section 2.
  sourceId    String   @unique @db.VarChar(400)
  // Assigned once at insert and NEVER rewritten. This is the public URL.
  slug        String   @unique @db.VarChar(191)
  title       String   @db.VarChar(512)
  description String?  @db.Text
  contentHtml String   @db.LongText // sanitized; see src/lib/substack/sanitize.js
  coverImage  String?  @db.VarChar(1024)
  author      String?  @db.VarChar(255)
  sourceUrl   String   @db.VarChar(1024)
  publishedAt DateTime
  // sha256 of exactly the mutable fields above. Equal hash => nothing to write.
  contentHash String   @db.Char(64)
  // Last time this ROW changed. An unchanged post is deliberately not touched,
  // so this is not "last time the feed was read" -- that belongs to the sync
  // report (#154).
  syncedAt    DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}

// How the Substack sync is doing. Exactly one row, id 1.
//
// It exists because the trigger moved onto the READ path
// (src/lib/substack/refresh.js): a failure there has no workflow run to redden
// and no operator watching, so "this has been failing for a week" has to outlive
// the process that saw it. Without this table a crash loop would also re-alert on
// every boot, since the counters would reset with the process.
//
// `lastReason` is a reportable()-capped feed-scope message and NEVER a Prisma
// error.message — P1001's contains the database host, and this repo's Actions
// logs and issue bodies are public.
model SubstackSyncStatus {
  id                  Int       @id @default(1)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  ok                  Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  firstFailureAt      DateTime?
  lastNotifiedAt      DateTime?
  lastReason          String?   @db.VarChar(255)
  updatedAt           DateTime  @updatedAt
}
